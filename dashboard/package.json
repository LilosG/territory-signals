{
  "name": "territory-signals-dashboard",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-maplibre-worker.mjs && astro dev",
    "build": "node scripts/copy-maplibre-worker.mjs && astro build",
    "build:prod": "node scripts/build-prod.mjs",
    "deploy": "npm run build:prod && wrangler deploy",
    "preview": "astro preview",
    "check": "astro check",
    "fixtures": "tsx scripts/generate-fixtures.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "check:contrast": "tsx scripts/check-contrast.ts",
    "e2e": "playwright test",
    "test:unit": "tsx --test src/lib/present.test.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.9",
    "@fontsource-variable/inter": "5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.1",
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.13",
    "echarts": "6.1.0",
    "maplibre-gl": "6.19.0",
    "tailwindcss": "4.3.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.65.1",
    "@types/geojson": "7946.0.16",
    "@types/node": "22.15.21",
    "playwright": "1.65.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "wrangler": "4.165.0"
  },
  "overrides": {
    "path-to-regexp": "6.3.0"
  }
