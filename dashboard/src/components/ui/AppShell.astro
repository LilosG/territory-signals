---
import '../../styles/global.css';
import { brand, brandCssVars } from '../../config/brand';
import { data } from '../../lib/data';
import Icon from './Icon.astro';
import SampleDataBadge from './SampleDataBadge.astro';
export interface Props { title: string; active?: 'today' | 'map' | 'trends' | 'pipeline' | 'settings' | 'system'; bleed?: boolean; description?: string }
const { title, active, bleed = false, description } = Astro.props;
const nav = [
  { key: 'today', href: '/', label: 'Today', icon: 'today' },
  { key: 'map', href: '/map', label: 'Map', icon: 'map' },
  { key: 'trends', href: '/trends', label: 'Trends', icon: 'trends' },
  { key: 'pipeline', href: '/pipeline', label: 'Pipeline', icon: 'pipeline' },
  { key: 'settings', href: '/settings', label: 'Settings', icon: 'settings' },
] as const;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description ?? `${brand.name} territory intelligence`} />
    <meta name="theme-color" content="#17294d" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%2317294D'/%3E%3C/svg%3E" />
    <title>{title} · {brand.shortName}</title>
    <style set:html={brandCssVars()}></style>
  </head>
  <body class="min-h-dvh">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50 focus:rounded-md focus:bg-surface focus:px-3 focus:py-2 focus:shadow-md">Skip to content</a>
    {data.isSample && (
      <div role="status" class="no-print border-b border-warning/25 bg-warning-soft px-4 py-1.5 text-center text-xs text-warning">
        <strong class="font-semibold">Sample data.</strong> Every owner, address, sale and signal on this page is fictional. No live data is connected.
      </div>
    )}
    <div class="lg:grid lg:grid-cols-[15rem_minmax(0,1fr)]">
      <aside class="no-print hidden lg:sticky lg:top-0 lg:flex lg:h-dvh lg:flex-col lg:border-r lg:border-line lg:bg-surface lg:px-4 lg:py-6">
        <a href="/" class="flex items-center gap-3 px-2 pb-8">
          <span class="grid h-9 w-9 place-items-center rounded-md bg-accent text-sm font-semibold tracking-wide text-accent-fg">{brand.initials}</span>
          <span class="leading-tight"><span class="block text-sm font-semibold">{brand.name}</span><span class="block text-xs text-ink-muted">{brand.tagline}</span></span>
        </a>
        <nav aria-label="Primary" class="flex flex-col gap-1">
          {nav.map((n) => (
            <a href={n.href} aria-current={active === n.key ? 'page' : undefined}
              class="flex items-center gap-3 rounded-md px-3 py-2.5 text-sm font-medium text-ink-muted transition-colors hover:bg-sunken hover:text-ink aria-[current=page]:bg-accent-soft aria-[current=page]:text-accent">
              <Icon name={n.icon} />{n.label}
            </a>
          ))}
        </nav>
        <p class="mt-auto px-2 text-xs text-ink-faint">Preview build · Phase 4</p>
      </aside>

      <div class="flex min-w-0 flex-col">
        <header class="no-print sticky top-0 z-30 flex h-14 items-center justify-between border-b border-line bg-surface/90 px-4 backdrop-blur sm:px-8">
          <div class="flex items-center gap-3 lg:hidden">
            <span class="grid h-8 w-8 place-items-center rounded-md bg-accent text-xs font-semibold text-accent-fg">{brand.initials}</span>
            <span class="text-sm font-semibold">{brand.shortName}</span>
          </div>
          <p class="hidden text-sm text-ink-muted lg:block">{title}</p>
          <div class="flex items-center gap-3">
            {data.isSample && <SampleDataBadge label="Sample data" />}
            <span class="grid h-8 w-8 place-items-center rounded-full bg-sunken text-xs font-semibold text-ink-muted" title="Signed-in user (sample)">SP</span>
          </div>
        </header>
        <main id="main" tabindex="-1" class:list={[bleed ? 'flex-1' : 'mx-auto w-full max-w-[84rem] flex-1 px-4 py-8 pb-28 sm:px-8 lg:pb-12']}>
          <slot />
        </main>
      </div>
    </div>

    <nav aria-label="Primary (mobile)" class="no-print fixed inset-x-0 bottom-0 z-30 grid grid-cols-5 border-t border-line bg-surface/95 pb-[env(safe-area-inset-bottom)] backdrop-blur lg:hidden">
      {nav.map((n) => (
        <a href={n.href} aria-current={active === n.key ? 'page' : undefined}
          class="flex flex-col items-center gap-0.5 py-2 text-2xs font-medium text-ink-muted aria-[current=page]:text-accent">
          <Icon name={n.icon} size={20} />{n.label}
        </a>
      ))}
    </nav>
  </body>
</html>
