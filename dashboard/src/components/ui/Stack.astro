---
export interface Props { gap?: 1 | 2 | 3 | 4 | 5 | 6 | 8 | 10 | 12; as?: 'div' | 'ul' | 'ol' | 'section'; class?: string }
const { gap = 4, as: Tag = 'div', class: cls } = Astro.props;
const g = { 1: 'gap-1', 2: 'gap-2', 3: 'gap-3', 4: 'gap-4', 5: 'gap-5', 6: 'gap-6', 8: 'gap-8', 10: 'gap-10', 12: 'gap-12' }[gap];
---
<Tag class:list={['flex flex-col', g, cls]}><slot /></Tag>
