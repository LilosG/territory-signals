---
export interface Props { gap?: 1 | 2 | 3 | 4 | 6; align?: 'start' | 'center' | 'between' | 'end'; wrap?: boolean; as?: 'div' | 'ul'; class?: string }
const { gap = 2, align = 'center', wrap = true, as: Tag = 'div', class: cls } = Astro.props;
const g = { 1: 'gap-1', 2: 'gap-2', 3: 'gap-3', 4: 'gap-4', 6: 'gap-6' }[gap];
const a = { start: 'items-start', center: 'items-center', end: 'items-end', between: 'items-center justify-between' }[align];
---
<Tag class:list={['flex', wrap && 'flex-wrap', g, a, cls]}><slot /></Tag>
