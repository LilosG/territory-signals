---
import type { OutreachItem } from '../../lib/data/types';
import { RECIPE_LABELS } from '../../lib/data/catalog';
import { fmtDate } from '../../lib/format';
import ScoreRing from './ScoreRing.astro';
export interface Props { task: OutreachItem }
const { task: o } = Astro.props;
const meta = [o.recipe ? (RECIPE_LABELS[o.recipe] ?? o.recipe) : null, o.due_date ? `Due ${fmtDate(o.due_date)}` : null, o.assigned_name ? `Assigned to ${o.assigned_name}` : null].filter(Boolean).join(' · ');
---
<li class="flex items-center gap-3 px-5 py-3">
  {o.score != null && <ScoreRing score={o.score} size="sm" />}
  <div class="min-w-0 flex-1">
    <a href={`/leads/${o.apn}`} class="block truncate text-sm font-medium hover:text-accent">{o.situs_address}</a>
    {meta && <p class="truncate text-xs text-ink-muted" title={meta}>{meta}</p>}
  </div>
</li>
