---
import { ringSvg, tierLabel, tierOf, type RingSize } from '../../lib/ring';
export interface Props { score: number; size?: RingSize; showLabel?: boolean; class?: string }
const { score, size = 'md', showLabel = false, class: cls } = Astro.props;
const label = `Score ${score} out of 100, ${tierLabel(score)}`;
---
<span class:list={['inline-flex shrink-0 items-center gap-2', cls]} data-tier={tierOf(score)}>
  <Fragment set:html={ringSvg(score, size, label)} />
  {showLabel && <span class="t-meta font-semibold" style={`color:var(--color-tier-${tierOf(score)})`}>{tierLabel(score)}</span>}
</span>
