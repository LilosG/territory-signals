---
import type { Outreach } from '../../lib/data/types';
import { COMPONENTS, RECIPE_LABELS } from '../../lib/data/catalog';
import { fmtDateTime, titleAddress } from '../../lib/format';
import { blockedHelp as help } from '../../lib/present';
import SourceLink from './SourceLink.astro';
import SampleDataBadge from './SampleDataBadge.astro';
import Button from './Button.astro';
export interface Props { draft: Outreach; back: string; canAct?: boolean }
const { draft, back, canAct = true } = Astro.props;
const status: Record<Outreach['status'], { label: string; cls: string }> = {
  draft: { label: 'Draft', cls: 'bg-sunken text-ink-muted' },
  awaiting_approval: { label: 'Awaiting approval', cls: 'bg-warning-soft text-warning' },
  approved: { label: 'Approved', cls: 'bg-good-soft text-good' },
  sent: { label: 'Sent', cls: 'bg-accent-soft text-accent' },
  suppressed: { label: 'Suppressed', cls: 'bg-critical-soft text-critical' },
};
const editable = draft.status === 'draft' || draft.status === 'awaiting_approval';
const reasons = (draft.blocked_reason ?? '').split(';').map((r) => r.trim()).filter(Boolean);
const PARCEL_FIELDS: Record<string, string> = { neighborhood: 'Neighborhood', situs_address: 'Street address' };
const facts = (draft.source_facts ?? []).map((f) => ({
  text: f.kind === 'component' ? `${COMPONENTS[f.key ?? '']?.label ?? f.key}${f.is_estimate ? ' (estimated)' : ''}${f.is_sample ? ' (sample data)' : ''}`
    : f.kind === 'parcel_field' ? `${PARCEL_FIELDS[f.parcel_field ?? ''] ?? f.parcel_field}: ${f.parcel_field === 'situs_address' ? titleAddress(String(f.value)) : String(f.value)}`
    : `${f.owner_field ?? f.kind}: ${String(f.value ?? '')}`,
  source_key: f.source_key ?? (f.kind === 'parcel_field' ? 'parcels' : 'sample_owner'),
  source_record_id: f.source_record_id ?? f.apn ?? '',
}));
---
<div class="flex flex-col gap-4" data-draft={draft.id}>
  <div class="flex flex-wrap items-center gap-2">
    <span data-draft-status class:list={['rounded-full px-2.5 py-0.5 text-xs font-medium', status[draft.status].cls]}>{status[draft.status].label}</span>
    {draft.uses_sample_data && <SampleDataBadge label="Sample" />}
    {draft.recipe && <span class="text-xs text-ink-muted">{RECIPE_LABELS[draft.recipe] ?? draft.recipe}</span>}
    <span class="text-xs text-ink-muted">Preview only. Nothing is sent, even when approved.</span>
  </div>

  {reasons.length > 0 && (
    <div role="note" data-blocked class="rounded-md border border-warning/30 bg-warning-soft px-4 py-3 text-sm text-warning">
      <p class="font-semibold">Blocked: {draft.blocked_reason}</p>
      <ul class="mt-1 list-disc pl-5 text-ink">{reasons.map((r) => <li>{help(r)}</li>)}</ul>
    </div>
  )}

  {editable && canAct
    ? <form method="post" action="/actions/edit" class="flex flex-col gap-2">
        <input type="hidden" name="id" value={draft.id} /><input type="hidden" name="back" value={back} />
        <label class="eyebrow" for={`c-${draft.id}`}>Draft text (edit before approving)</label>
        <textarea id={`c-${draft.id}`} name="content" rows="12" required class="w-full rounded-md border border-line-strong bg-canvas p-4 text-sm leading-6 text-ink focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30">{draft.content}</textarea>
        <div><Button type="submit" size="sm" variant="secondary">Save edit</Button></div>
      </form>
    : <div class="whitespace-pre-wrap rounded-md border border-line bg-canvas p-5 text-sm leading-6 text-ink">{draft.content}</div>}
  {draft.edited_by && <p class="text-xs text-ink-muted" data-edited>Edited by {draft.edited_by} · {fmtDateTime(draft.edited_at)}. The original text is kept.</p>}
  {draft.approved_by && <p class="text-xs text-ink-muted">Approved by {draft.approved_by}.</p>}

  {editable && (
    <form method="post" action="/actions/approve" class="flex flex-wrap items-center gap-3">
      <input type="hidden" name="id" value={draft.id} /><input type="hidden" name="back" value={back} />
      <Button type="submit" variant="primary" disabled={reasons.length > 0 || !canAct} title={reasons.length ? `Cannot approve: ${draft.blocked_reason}` : undefined} id={`approve-${draft.id}`}>Approve draft</Button>
      {reasons.length > 0 && <span class="text-xs text-ink-muted">Approve is off until the items above are fixed.</span>}
    </form>
  )}

  {facts.length > 0 && (
    <div>
      <p class="eyebrow mb-2">Facts used (from the database)</p>
      <ul class="flex flex-col gap-2">
        {facts.map((f) => (
          <li class="flex flex-wrap items-baseline gap-x-3 gap-y-0.5 text-sm"><span>{f.text}</span><SourceLink sourceKey={f.source_key} recordId={f.source_record_id} /></li>
        ))}
      </ul>
    </div>
  )}
</div>
