---
export interface Props { label?: string; class?: string }
const { label = 'Sample', class: cls } = Astro.props;
---
<span title="Sample data: not a real record" class:list={['inline-flex items-center rounded-full border border-warning/30 bg-warning-soft px-1.5 py-px text-2xs font-semibold uppercase tracking-wide text-warning whitespace-nowrap align-middle', cls]}>{label}</span>
