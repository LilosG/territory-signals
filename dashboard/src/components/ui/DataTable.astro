---
import ScoreBadge from './ScoreBadge.astro';
import Icon from './Icon.astro';
export interface Column { key: string; label: string; type?: 'text' | 'number' | 'score' | 'date'; align?: 'left' | 'right'; sortable?: boolean; hideOnMobile?: boolean }
export interface Cell { v: string | number | null; display?: string; href?: string }
export interface Row { cells: Record<string, Cell>; href?: string }
export interface Props { columns: Column[]; rows: Row[]; caption: string; defaultSort?: { key: string; dir: 'asc' | 'desc' }; class?: string }
const { columns, rows, caption, defaultSort, class: cls } = Astro.props;
const sortVal = (c: Cell) => (c.v ?? '');
---
<div class:list={['overflow-x-auto rounded-lg border border-line bg-surface', cls]}>
  <table data-sortable class="w-full border-collapse text-sm">
    <caption class="sr-only">{caption}</caption>
    <thead class="bg-sunken text-left">
      <tr>
        {columns.map((c) => (
          <th scope="col" data-key={c.key} data-type={c.type ?? 'text'} aria-sort={defaultSort?.key === c.key ? (defaultSort.dir === 'asc' ? 'ascending' : 'descending') : c.sortable ? 'none' : undefined}
            class:list={['px-4 py-3 text-xs font-medium uppercase tracking-wide text-ink-muted whitespace-nowrap', c.align === 'right' && 'text-right', c.hideOnMobile && 'max-sm:hidden']}>
            {c.sortable
              ? <button type="button" class:list={['inline-flex items-center gap-1 uppercase tracking-wide hover:text-ink', c.align === 'right' && 'flex-row-reverse']}>{c.label}<Icon name="sort" size={12} /></button>
              : c.label}
          </th>
        ))}
      </tr>
    </thead>
    <tbody class="divide-y divide-line">
      {rows.map((r) => (
        <tr class="hover:bg-canvas/70">
          {columns.map((c, i) => {
            const cell = r.cells[c.key] ?? { v: null };
            const txt = cell.display ?? (cell.v == null ? '—' : String(cell.v));
            return (
              <td data-sort={String(sortVal(cell))} class:list={['px-4 py-3 align-middle', c.align === 'right' && 'text-right tabular-nums', c.hideOnMobile && 'max-sm:hidden', i === 0 && 'font-medium text-ink']}>
                {c.type === 'score' && typeof cell.v === 'number'
                  ? <ScoreBadge score={cell.v} size="sm" />
                  : (cell.href ?? (i === 0 ? r.href : undefined))
                    ? <a href={cell.href ?? r.href} class="text-ink hover:text-accent hover:underline underline-offset-2">{txt}</a>
                    : txt}
              </td>
            );
          })}
        </tr>
      ))}
    </tbody>
  </table>
</div>
<script>
  document.querySelectorAll<HTMLTableElement>('table[data-sortable]').forEach((table) => {
    const body = table.tBodies[0]!;
    table.querySelectorAll<HTMLTableCellElement>('thead th').forEach((th, idx) => {
      const btn = th.querySelector('button'); if (!btn) return;
      btn.addEventListener('click', () => {
        const dir = th.getAttribute('aria-sort') === 'ascending' ? 'descending' : 'ascending';
        table.querySelectorAll('thead th').forEach((x) => x.hasAttribute('aria-sort') && x.setAttribute('aria-sort', 'none'));
        th.setAttribute('aria-sort', dir);
        const numeric = th.dataset.type === 'number' || th.dataset.type === 'score';
        const rows = Array.from(body.rows);
        rows.sort((a, b) => {
          const av = a.cells[idx]!.dataset.sort ?? '', bv = b.cells[idx]!.dataset.sort ?? '';
          const c = numeric ? (parseFloat(av) || 0) - (parseFloat(bv) || 0) : av.localeCompare(bv);
          return dir === 'ascending' ? c : -c;
        });
        rows.forEach((r) => body.appendChild(r));
      });
    });
  });
</script>
