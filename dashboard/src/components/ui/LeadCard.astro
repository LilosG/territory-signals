---
import type { LeadSummary } from '../../lib/data/types';
import { LEAD_STATUS } from '../../lib/data/catalog';
import { gciBadge, leadChips, leadHeadline, publicReason, reasonParts } from '../../lib/present';
import Card from './Card.astro';
import ScoreRing from './ScoreRing.astro';
import StatusPill from './StatusPill.astro';
import SampleDataBadge from './SampleDataBadge.astro';
import Fact from './Fact.astro';
import Icon from './Icon.astro';
/**
 * Compact lead card: facts on the left, the score ring and estimated GCI on the right. Never shows distress or life-event
 * chips (those live in the lead brief; leadChips enforces it). One sample badge per card; the GCI badge is dotted-underlined
 * when it rests on sample owner data.
 */
export interface Props { lead: LeadSummary; rank?: number; isNew?: boolean }
const { lead, rank, isNew = false } = Astro.props;
const { parcel: p, score } = lead;
const status = LEAD_STATUS[lead.status];
const headline = leadHeadline(lead);
const chips = leadChips(lead);
const gci = gciBadge(lead);
const reason = reasonParts(publicReason(score.reason_text));
---
<Card as="article" interactive padded={false} class="group">
  <a href={`/leads/${p.apn}`} class="flex items-center gap-3 rounded-lg p-4 sm:gap-5">
    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1">
        <div class="flex min-w-0 flex-wrap items-baseline gap-x-2">
          {rank != null && <span class="text-xs font-semibold text-ink-faint" aria-label={`Rank ${rank}`}>#{rank}</span>}
          <h3 class="truncate text-base font-semibold text-ink group-hover:text-accent">{p.situs_address}</h3>
          {isNew && lead.status !== 'new' && <span class="new-marker">New</span>}
          <span class="t-meta text-ink-muted">{p.neighborhood}</span>
        </div>
        <span class="flex items-center gap-2">
          {lead.is_sample && <SampleDataBadge />}
          <StatusPill tone={status.tone}>{status.label}</StatusPill>
        </span>
      </div>
      {lead.ai_headline
        ? (
          <>
            <p class="mt-1 flex items-start gap-1.5 text-base font-semibold text-ink" data-ai-headline>
              <span class="mt-1 shrink-0 text-accent" role="img" aria-label="AI summary" title="AI summary" data-ai-sparkle><Icon name="sparkle" size={14} /></span>
              <span class="min-w-0">{lead.ai_headline}</span>
            </p>
            {headline && <p class="mt-0.5 text-sm text-ink-muted" data-top-signal><Fact {...headline} /></p>}
          </>
        )
        : headline && <p class="mt-1 text-base font-medium text-ink"><Fact {...headline} /></p>}
      {chips.length > 0 && (
        <ul class="mt-2 flex flex-wrap gap-1.5" data-fact-chips>
          {chips.map((c) => (
            <li class="inline-flex items-center gap-1 rounded-md bg-sunken px-2 py-0.5 text-xs font-medium text-ink-muted" data-chip-icon={c.icon}>
              {c.icon && <Icon name={c.icon} size={13} class="shrink-0 text-gold" />}<Fact {...c} />
            </li>
          ))}
        </ul>
      )}
    </div>
    <div class="flex shrink-0 flex-col items-center gap-1.5 self-start" data-card-right>
      <ScoreRing score={score.score} size="lg" />
      {gci && (
        <span data-gci-badge class:list={['whitespace-nowrap rounded-full border border-gold/40 bg-gold-soft px-2 py-0.5 text-2xs font-semibold text-gold-strong', gci.sample && 'sample-fact']}
          title={gci.sample ? 'Estimated at 2.5% of estimated property value, which rests on sample owner data' : 'Estimated gross commission income: 2.5% of estimated property value'}>{gci.text}</span>
      )}
    </div>
  </a>
  {reason.length > 0 && (
    <details class="group/d border-t border-line px-4 py-2 text-sm">
      <summary class="cursor-pointer list-none rounded text-xs font-medium text-ink-muted hover:text-ink">Why this score <span class="group-open/d:hidden">▸</span><span class="hidden group-open/d:inline">▾</span></summary>
      <p class="mt-2 text-ink-muted">{reason.map((r) => <Fact {...r} />)}</p>
    </details>
  )}
</Card>
