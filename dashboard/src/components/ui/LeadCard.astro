---
import type { LeadSummary } from '../../lib/data/types';
import { LEAD_STATUS } from '../../lib/data/catalog';
import { fmtUsdCompact, fmtDate, sentenceCase } from '../../lib/format';
import Card from './Card.astro';
import ScoreBadge from './ScoreBadge.astro';
import RecipeTag from './RecipeTag.astro';
import SignalChip from './SignalChip.astro';
import StatusPill from './StatusPill.astro';
import SampleDataBadge from './SampleDataBadge.astro';
import Icon from './Icon.astro';
export interface Props { lead: LeadSummary; recipeNames: Record<string, string>; rank?: number }
const { lead, recipeNames, rank } = Astro.props;
const { parcel: p, score, owner } = lead;
const status = LEAD_STATUS[lead.status];
// Recipes first (max 2), then up to 3 signal types. Overflow becomes "+N".
const recipes = score.recipe_matches;
const signals = lead.top_signal_types;
const shownRecipes = recipes.slice(0, 2), shownSignals = signals.slice(0, 3);
const more = recipes.length - shownRecipes.length + signals.length - shownSignals.length;
---
<Card as="article" interactive padded={false} class="group">
  <a href={`/leads/${p.apn}`} class="flex items-center gap-3 rounded-lg p-4 sm:gap-4 sm:p-5">
    <div class="flex flex-col items-center gap-1 self-start">
      <ScoreBadge score={score.score} size="lg" />
      {rank != null && <span class="text-2xs text-ink-faint">#{rank}</span>}
    </div>
    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1">
        <div class="flex min-w-0 flex-wrap items-baseline gap-x-2">
          <h3 class="text-base font-semibold text-ink group-hover:text-accent">{p.situs_address}</h3>
          <span class="text-sm text-ink-muted">{p.neighborhood}</span>
        </div>
        <StatusPill tone={status.tone}>{status.label}</StatusPill>
      </div>
      <p class="mt-1 text-sm text-ink-muted max-sm:line-clamp-2">{sentenceCase(score.reason_text)}</p>
      <div class="mt-3 flex flex-wrap items-center gap-1.5 max-sm:hidden">
        {shownRecipes.map((r) => <RecipeTag name={recipeNames[r] ?? r} />)}
        {shownSignals.map((t) => <SignalChip type={t} />)}
        {more > 0 && <span class="text-xs font-medium text-ink-muted" title={`${more} more`}>+{more}</span>}
      </div>
      <p class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-ink-muted sm:mt-3">
        {owner && <span>{owner.owner_name} {owner.is_sample && <SampleDataBadge />}</span>}
        {lead.years_owned != null && <span>{lead.years_owned} years owned</span>}
        {owner?.est_equity != null && <span class="max-sm:hidden">{fmtUsdCompact(owner.est_equity)} est. equity</span>}
        {lead.latest_signal_date && <span class="max-sm:hidden">Latest signal {fmtDate(lead.latest_signal_date)}</span>}
      </p>
    </div>
    <Icon name="chevron" size={20} class="shrink-0 self-center text-ink-faint transition-transform group-hover:translate-x-0.5 group-hover:text-accent max-sm:hidden" />
  </a>
</Card>
