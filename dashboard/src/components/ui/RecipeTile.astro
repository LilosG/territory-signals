---
import type { RecipeWeek } from '../../lib/data/types';
import { fmtNum } from '../../lib/format';
/** Compact recipe tile for the Today grid. Links to the leads list filtered to that recipe. A recipe with no matches yet is muted
 *  and says "Waiting on data" instead of 0. The label wraps, so a long name ("Financial pressure") is never clipped. */
export interface Props { recipe: RecipeWeek }
const { recipe: r } = Astro.props;
const idle = r.parcels === 0 && r.new_this_week === 0;
---
<a href={`/leads?recipe=${encodeURIComponent(r.key)}`} data-recipe-tile={r.key} data-idle={idle ? '' : undefined} title={idle ? (r.idle_reason ?? undefined) : undefined}
  class:list={['card-hover flex h-full min-w-0 flex-col gap-1 rounded-lg border px-4 py-3', idle ? 'border-dashed border-line bg-sunken' : 'border-line bg-surface']}>
  <span class="t-meta break-words text-ink-muted">{r.label}</span>
  {idle
    ? <span class="text-sm font-medium text-ink-faint">Waiting on data</span>
    : <span class="text-xl font-semibold tabular-nums text-ink">{fmtNum(r.parcels)}</span>}
  {!idle && <span class="text-xs text-ink-muted">{r.new_this_week > 0 ? <span class="new-marker">+{fmtNum(r.new_this_week)} new</span> : 'None new'}</span>}
</a>
