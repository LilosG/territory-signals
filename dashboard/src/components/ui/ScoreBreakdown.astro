---
import { sentenceCase } from '../../lib/format';
import type { ScoreItem } from '../../lib/data/types';
export interface Props { items: ScoreItem[]; class?: string; /** On phones show this many, with a "Show all" button. */ collapsedCount?: number }
const { items, collapsedCount = 3 } = Astro.props;
const fmt = (n: number) => (Number.isInteger(n) ? String(n) : n.toFixed(1));
---
<div data-score-breakdown>
  <ul class:list={['flex flex-col gap-3', Astro.props.class]}>
    {items.map((i, idx) => (
      <li class:list={[idx >= collapsedCount && 'max-sm:[[data-score-breakdown]:not([data-open])_&]:hidden']}>
        <div class="flex items-baseline justify-between gap-3 text-sm"><span class:list={[i.points ? 'text-ink' : 'text-ink-muted']}>{sentenceCase(i.label)}</span><span class="shrink-0 tabular-nums text-ink-muted"><span class="font-medium text-ink">{fmt(i.points)}</span> / {fmt(i.max)}</span></div>
        <div class="mt-1.5 h-1.5 overflow-hidden rounded-full bg-sunken" role="meter" aria-label={i.label} aria-valuemin="0" aria-valuemax={i.max} aria-valuenow={i.points}>
          <div class="h-full rounded-full bg-accent" style={`width:${Math.min(100, Math.round((i.points / i.max) * 100))}%`}></div>
        </div>
      </li>
    ))}
  </ul>
  {items.length > collapsedCount && (
    <button type="button" data-score-toggle class="mt-3 text-sm font-medium text-accent hover:underline sm:hidden" aria-expanded="false">Show all {items.length}</button>
  )}
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-score-breakdown]').forEach((root) => {
    const btn = root.querySelector<HTMLButtonElement>('[data-score-toggle]');
    btn?.addEventListener('click', () => {
      const open = root.toggleAttribute('data-open');
      btn.setAttribute('aria-expanded', String(open));
      btn.textContent = open ? 'Show top 3' : `Show all ${root.querySelectorAll('li').length}`;
    });
  });
</script>
