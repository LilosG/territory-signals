---
import type { StatSeries } from '../../lib/data/types';
import { weekDelta } from '../../lib/present';
import { fmtNum } from '../../lib/format';
import Card from './Card.astro';
import Spark from './Spark.astro';
/** One Today tile: this week's number, week-over-week change and a 14-day sparkline. */
export interface Props { label: string; series: StatSeries | undefined }
const { label, series } = Astro.props;
const d = series ? weekDelta(series.this_week, series.last_week) : null;
const tone = d?.dir === 'up' ? 'text-good' : d?.dir === 'down' ? 'text-warning' : 'text-ink-muted';
---
<Card class="!p-4" data-stat={series?.metric}>
  <p class="t-meta text-ink-muted">{label}</p>
  <div class="mt-1 flex items-end justify-between gap-2">
    <p class="text-3xl font-semibold tabular-nums tracking-tight text-ink">{fmtNum(series?.this_week ?? 0)}</p>
    {series && <Spark values={series.days.map((x) => x.n)} />}
  </div>
  <p class:list={['mt-1 truncate text-xs font-medium', tone]}>{d?.label ?? 'No data yet'}</p>
</Card>
