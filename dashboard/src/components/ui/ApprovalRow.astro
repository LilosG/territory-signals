---
import type { OutreachItem } from '../../lib/data/types';
import Icon from './Icon.astro';
import Button from './Button.astro';
export interface Props { item: OutreachItem }
const { item: o } = Astro.props;
const kind = o.channel === 'mail' ? { icon: 'letter', label: 'Letter' } : { icon: 'mail', label: 'Email' };
---
<li class="flex items-center gap-3 px-5 py-3">
  <span class="grid h-8 w-8 shrink-0 place-items-center rounded-md bg-sunken text-ink-muted" title={`${kind.label} draft`}>
    <Icon name={kind.icon as 'letter' | 'mail'} size={16} /><span class="sr-only">{kind.label} draft</span>
  </span>
  <a href={`/leads/${o.apn}#drafts`} class="min-w-0 flex-1 truncate text-sm font-medium hover:text-accent">{o.situs_address}</a>
  <Button size="sm" variant="secondary" href={`/leads/${o.apn}#drafts`} class="shrink-0">Review</Button>
</li>
