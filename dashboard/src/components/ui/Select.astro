---
export interface Option { value: string; label: string }
export interface Props { label: string; name: string; options: Option[]; value?: string; id?: string; hideLabel?: boolean; class?: string }
const { label, name, options, value = '', id = `sel-${name}`, hideLabel = false, class: cls } = Astro.props;
---
<div class:list={['flex flex-col gap-1', cls]}>
  <label for={id} class:list={[hideLabel ? 'sr-only' : 'text-xs font-medium text-ink-muted']}>{label}</label>
  <div class="relative">
    <select id={id} name={name} class="h-10 w-full appearance-none rounded-md border border-line-strong bg-surface pl-3 pr-9 text-sm text-ink hover:bg-sunken/60">
      {options.map((o) => <option value={o.value} selected={o.value === value}>{o.label}</option>)}
    </select>
    <svg class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-ink-muted" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
  </div>
</div>
