---
export interface Props { title?: string; description?: string; id?: string; class?: string }
const { title, description, id, class: cls } = Astro.props;
const hid = id ? `${id}-h` : undefined;
---
<section id={id} aria-labelledby={title ? hid : undefined} class:list={['flex flex-col gap-4', cls]}>
  {title && (
    <header class="flex flex-wrap items-end justify-between gap-x-4 gap-y-1">
      <div>
        <h2 id={hid} class="text-lg font-semibold text-ink">{title}</h2>
        {description && <p class="text-sm text-ink-muted mt-0.5">{description}</p>}
      </div>
      <slot name="actions" />
    </header>
  )}
  <slot />
</section>
