---
import type { Signal } from '../../lib/data/types';
import { fmtDate } from '../../lib/format';
import ConfidenceIndicator from './ConfidenceIndicator.astro';
import SampleDataBadge from './SampleDataBadge.astro';
import SignalChip from './SignalChip.astro';
import SourceLink from './SourceLink.astro';
import EmptyState from './EmptyState.astro';
export interface Props { signals: Signal[]; class?: string }
// Dated events only: every item has a date. Owner traits (tenure, equity, mortgage, occupancy) live in the owner panel.
const signals = Astro.props.signals.filter((s) => !!s.signal_date);
---
{signals.length === 0
  ? <EmptyState title="No signals yet" description="Nothing has been detected for this parcel." />
  : <ol class:list={['relative flex flex-col', Astro.props.class]}>
      {signals.map((s, i) => (
        <li class="relative grid grid-cols-[1.25rem_minmax(0,1fr)] gap-x-4 pb-6 last:pb-0">
          <span class="relative flex justify-center" aria-hidden="true">
            <span class:list={['mt-1.5 h-2.5 w-2.5 rounded-full ring-4 ring-surface', s.is_estimate ? 'border-2 border-accent bg-surface' : 'bg-accent']}></span>
            {i < signals.length - 1 && <span class="absolute top-4 bottom-[-1.25rem] w-px bg-line"></span>}
          </span>
          <div class="min-w-0">
            <!-- meta line, the same on every item: chip, date, badge -->
            <div class="flex min-w-0 flex-nowrap items-center gap-x-3">
              <SignalChip type={s.signal_type} details={s.details} estimate={s.is_estimate} class="min-w-0 shrink" />
              <time class="shrink-0 whitespace-nowrap text-sm text-ink-muted" datetime={s.signal_date ?? undefined}>{fmtDate(s.signal_date)}</time>
              {s.is_sample && <SampleDataBadge class="shrink-0" />}
            </div>
            <div class="mt-1.5 flex flex-wrap items-center gap-x-4 gap-y-1">
              <SourceLink sourceKey={s.source_key} recordId={s.source_record_id} />
              <ConfidenceIndicator confidence={s.confidence} method={s.match_method} />
            </div>
          </div>
        </li>
      ))}
    </ol>}
