---
import { sentenceCase } from '../../lib/format';
export interface Props { name: string; class?: string }
---
<span data-recipe-tag class:list={['inline-flex items-center whitespace-nowrap rounded-full bg-accent px-2.5 py-0.5 text-xs font-semibold text-accent-fg', Astro.props.class]}>{sentenceCase(Astro.props.name)}</span>
