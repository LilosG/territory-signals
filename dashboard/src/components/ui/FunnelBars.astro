---
import type { FunnelRow } from '../../lib/data/types';
import { fmtPct, fmtNum } from '../../lib/format';
export interface Props { rows: FunnelRow[]; caption: string }
const { rows, caption } = Astro.props;
const SMALL = 5; // below this count a percentage is not trustworthy
---
<div role="group" aria-label={caption} class:list={['grid gap-x-10 gap-y-8', rows.length > 1 ? 'lg:grid-cols-2' : 'max-w-3xl']}>
  {rows.map((r) => {
    const top = Math.max(1, r.stages[0]!.count);
    return (
      <section aria-label={r.label} class="min-w-0">
        {rows.length > 1 && <h3 class="mb-3 text-sm font-semibold">{r.label}</h3>}
        <ol class="flex flex-col">
          {r.stages.map((s, i) => {
            const prev = i > 0 ? r.stages[i - 1]! : null;
            const small = s.count < SMALL;
            return (
              <>
                {prev && (
                  <li aria-hidden="false" class="flex items-center gap-2 py-1 pl-1 text-2xs text-ink-muted">
                    <span aria-hidden="true">↓</span>
                    {prev.count > 0
                      ? <span title={small ? 'Small sample' : undefined} class:list={['tabular-nums', small && 'cursor-help text-ink-faint']}>{fmtPct(s.count / prev.count)} <span class="text-ink-faint">· {fmtNum(s.count)} of {fmtNum(prev.count)}</span></span>
                      : <span class="text-ink-faint">no leads at the prior stage</span>}
                  </li>
                )}
                <li class="grid grid-cols-[minmax(0,1fr)_7.5rem] items-center gap-3">
                  <div class="h-6 overflow-hidden rounded-sm bg-sunken" aria-hidden="true">
                    <div class="h-full rounded-sm bg-accent" style={`width:${s.count > 0 ? Math.max(1.5, (s.count / top) * 100) : 0}%;opacity:${1 - i * 0.12}`}></div>
                  </div>
                  <p class="flex items-baseline gap-1.5 whitespace-nowrap"><span class="text-base font-semibold tabular-nums">{fmtNum(s.count)}</span><span class="text-xs text-ink-muted">{s.label}</span></p>
                </li>
              </>
            );
          })}
        </ol>
      </section>
    );
  })}
</div>
