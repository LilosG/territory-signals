---
import type { WeeklyBriefAi } from '../../lib/data/types';
import { fmtDate } from '../../lib/format';
import AiTag from './AiTag.astro';
import Card from './Card.astro';
/** "This week" card at the top of Today: the AI intro plus a link to the full briefing. */
export interface Props { brief: WeeklyBriefAi }
const { brief } = Astro.props;
---
<Card as="section" aria-labelledby="week-h" data-week-card>
  <div class="flex flex-wrap items-center gap-2"><h2 id="week-h" class="t-h2">This week</h2><AiTag /><span class="t-meta text-ink-muted">Week of {fmtDate(brief.week_start)}</span></div>
  <p class="mt-2 text-base text-ink" data-week-intro>{brief.intro}</p>
  <p class="mt-3 text-sm"><a href={`/reports/briefings/${brief.week_start}`} class="font-medium text-accent hover:underline" data-week-link>Read the full briefing →</a></p>
</Card>
