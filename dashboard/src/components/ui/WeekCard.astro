---
import type { WeeklyBriefAi } from '../../lib/data/types';
import { fmtDate } from '../../lib/format';
import AiTag from './AiTag.astro';
import CopyButton from './CopyButton.astro';
/**
 * Executive briefing card (left of the Today hero): deep navy, gold eyebrow, the AI intro and a one-click newsletter block.
 * Without a stored AI briefing it shows a plain summary built from this week's counts (no AI tag) and copies that instead.
 */
export interface Props { brief: WeeklyBriefAi | null; fallback: string; fallbackWeek: string }
const { brief, fallback, fallbackWeek } = Astro.props;
const block = brief ? `${brief.title}\n\n${brief.newsletter_paragraph}` : fallback;
---
<section aria-labelledby="week-h" data-week-card={brief ? "" : undefined} data-hero-brief class="flex h-full flex-col rounded-xl border border-white/10 bg-hero p-6 text-white shadow-lift sm:p-8">
  <p class="eyebrow-gold">Weekly territory briefing · Week of {fmtDate(brief?.week_start ?? fallbackWeek)}</p>
  <div class="mt-2 flex flex-wrap items-center gap-2"><h2 id="week-h" class="text-2xl font-semibold tracking-tight text-white">{brief?.title ?? 'This week'}</h2>{brief && <AiTag class="!border-white/30 !bg-white/10 !text-white" />}</div>
  <p class="mt-3 max-w-prose text-base leading-7 text-white/90" data-week-intro>{brief?.intro ?? fallback}</p>
  <div class="mt-auto flex flex-wrap items-center gap-x-5 gap-y-3 pt-6">
    <CopyButton tone="hero" label="Copy newsletter block" text={block} id="copy-newsletter" />
    {brief && <a href={`/reports/briefings/${brief.week_start}`} class="text-sm font-medium text-[#f2d9a6] underline-offset-4 hover:underline focus-visible:outline-white" data-week-link>Read the full briefing →</a>}
  </div>
</section>
