---
import type { LeadBriefAi } from '../../lib/data/types';
import { claimHref, claimLabel } from '../../lib/present';
import AiTag from './AiTag.astro';
import Card from './Card.astro';
import SampleDataBadge from './SampleDataBadge.astro';
/** The AI summary at the top of a lead brief: headline, summary, claims that each link to their source record. */
export interface Props { brief: LeadBriefAi; apn: string }
const { brief } = Astro.props;
---
<Card as="section" aria-labelledby="ai-h" class="mb-6" data-ai-brief>
  <div class="flex flex-wrap items-center gap-2"><AiTag />{brief.uses_sample && <SampleDataBadge />}</div>
  <h2 id="ai-h" class="t-h2 mt-2 text-ink" data-ai-headline>{brief.headline}</h2>
  <p class="mt-2 text-base text-ink" data-ai-summary>{brief.summary}</p>
  <ul class="mt-4 flex flex-col gap-2 border-t border-line pt-4 text-sm" aria-label="Claims and their sources">
    {brief.claims.map((c) => (
      <li class="flex flex-wrap items-baseline gap-x-2" data-ai-claim>
        <span class="text-ink">{c.text}</span>
        <span class="flex flex-wrap gap-x-2">{c.record_ids.map((id) => <a href={claimHref(id)} data-claim-link class="text-xs font-medium text-accent underline decoration-accent/40 underline-offset-2 hover:decoration-accent">{claimLabel(id)}</a>)}</span>
      </li>
    ))}
  </ul>
  <p class="mt-4 text-xs text-ink-muted"><span class="font-medium text-ink">Suggested angle (internal):</span> {brief.suggested_angle}</p>
  <p class="mt-2 text-2xs text-ink-faint">Written by AI using only the stored records linked above. The score and recipes are computed separately.</p>
</Card>
