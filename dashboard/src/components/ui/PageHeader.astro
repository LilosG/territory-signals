---
export interface Props { title: string; eyebrow?: string; description?: string; class?: string }
---
<header class:list={['flex flex-wrap items-end justify-between gap-x-6 gap-y-4 pb-6', Astro.props.class]}>
  <div class="min-w-0">
    {Astro.props.eyebrow && <p class="eyebrow mb-1.5">{Astro.props.eyebrow}</p>}
    <h1 class="text-2xl sm:text-3xl font-semibold text-ink">{Astro.props.title}</h1>
    {Astro.props.description && <p class="mt-1.5 max-w-2xl text-base text-ink-muted">{Astro.props.description}</p>}
  </div>
  <div class="flex flex-wrap items-center gap-2 empty:hidden"><slot /></div>
</header>
