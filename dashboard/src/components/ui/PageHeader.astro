---
export interface Props { title: string; eyebrow?: string; description?: string; class?: string }
---
<header class:list={['flex flex-wrap items-end justify-between gap-x-6 gap-y-3 pb-4 sm:pb-6', Astro.props.class]}>
  <div class="min-w-0">
    {Astro.props.eyebrow && <p class="eyebrow mb-1">{Astro.props.eyebrow}</p>}
    <h1 class="t-page-title text-ink">{Astro.props.title}</h1>
    {Astro.props.description && <p class="mt-1 max-w-2xl text-sm text-ink-muted sm:mt-1.5 sm:text-base">{Astro.props.description}</p>}
  </div>
  <div class="flex flex-wrap items-center gap-2 empty:hidden"><slot /></div>
</header>
