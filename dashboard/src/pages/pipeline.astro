---
import AppShell from '../components/ui/AppShell.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import Card from '../components/ui/Card.astro';
import Section from '../components/ui/Section.astro';
import Stack from '../components/ui/Stack.astro';
import FunnelBars from '../components/ui/FunnelBars.astro';
import StatTile from '../components/ui/StatTile.astro';
import SampleDataBadge from '../components/ui/SampleDataBadge.astro';
import { data } from '../lib/data';
import { fmtDate, fmtPct } from '../lib/format';
const [pipe, bt] = await Promise.all([data.getPipeline(), data.getBacktest()]);
---
<AppShell title="Pipeline" active="pipeline">
  <PageHeader eyebrow="Signals to listings" title="Pipeline" description="How flagged properties move from signal to listing, by agent and by recipe." />
  <Stack gap={10}>
    <Card as="section" aria-labelledby="bt-h">
      <div class="flex flex-wrap items-center gap-2"><h2 id="bt-h" class="text-lg font-semibold">Backtest</h2><SampleDataBadge label="Sample until Phase 6" /></div>
      <p class="mt-1 text-sm text-ink-muted">Would we have seen past sales coming? Share of past sales flagged before they listed, and how early.</p>
      <dl class="mt-6 grid grid-cols-2 gap-6 sm:grid-cols-4">
        <StatTile emphasis label="Flagged before listing" value={fmtPct(bt.share_flagged)} hint={`${bt.flagged_before_listing} of ${bt.past_sales_considered} past sales`} />
        <StatTile emphasis label="Average days early" value={String(bt.avg_days_early)} hint="days before the listing date" />
        <StatTile label="Median days early" value={String(bt.median_days_early)} />
        <StatTile label="Window" value={`${fmtDate(bt.window.from)} – ${fmtDate(bt.window.to)}`} />
      </dl>
      <p class="mt-5 border-t border-line pt-4 text-xs text-ink-muted">{bt.note}</p>
    </Card>

    <Section title="Overall funnel" description="Leads scoring 60 or higher. Each stage shows the share that advanced from the stage before.">
      <Card><FunnelBars caption="Overall funnel" rows={[pipe.overall]} /></Card>
    </Section>
    <Stack gap={10}>
      <Section title="By agent"><Card><FunnelBars caption="Funnel by agent" rows={pipe.by_agent} /></Card></Section>
      <Section title="By recipe"><Card><FunnelBars caption="Funnel by recipe" rows={pipe.by_recipe} /></Card></Section>
    </Stack>
  </Stack>
</AppShell>
