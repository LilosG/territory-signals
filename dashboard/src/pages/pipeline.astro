---
import AppShell from '../components/ui/AppShell.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import Card from '../components/ui/Card.astro';
import Section from '../components/ui/Section.astro';
import Stack from '../components/ui/Stack.astro';
import FunnelBars from '../components/ui/FunnelBars.astro';
import StatTile from '../components/ui/StatTile.astro';
import SampleDataBadge from '../components/ui/SampleDataBadge.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import { fmtDate, fmtPct } from '../lib/format';
export const prerender = false;
const [pipe, bt] = await Promise.all([Astro.locals.data.getPipeline(), Astro.locals.data.getBacktest()]);
---
<AppShell title="Pipeline" active="pipeline">
  <PageHeader eyebrow="Signals to listings" title="Pipeline" description="How flagged properties move from signal to listing, by agent and by recipe." />
  <Stack gap={10}>
    <Card as="section" aria-labelledby="bt-h">
      <div class="flex flex-wrap items-center gap-2"><h2 id="bt-h" class="text-lg font-semibold">Backtest</h2>{bt?.is_sample && <SampleDataBadge label="Sample until Phase 6" />}</div>
      {bt
        ? <>
            <p class="mt-0.5 text-sm text-ink-muted">{fmtDate(bt.window.from)} – {fmtDate(bt.window.to)}</p>
            <p class="mt-2 text-sm text-ink-muted">Would we have seen past sales coming? Share of past sales flagged before they listed, and how early.</p>
            <dl class="mt-6 grid grid-cols-2 gap-6 sm:grid-cols-4">
              <StatTile emphasis label="Flagged before listing" value={fmtPct(bt.share_flagged)} hint={`of past sales · ${bt.flagged_before_listing} of ${bt.past_sales_considered}`} smallSample={bt.flagged_before_listing < 5} />
              <StatTile emphasis label="Average days early" value={String(bt.avg_days_early)} hint="days" />
              <StatTile label="Median days early" value={String(bt.median_days_early)} hint="days" />
              <StatTile label="Past sales considered" value={String(bt.past_sales_considered)} hint="sales" />
            </dl>
            <p class="mt-5 border-t border-line pt-4 text-xs text-ink-muted">{bt.note}</p>
          </>
        : <EmptyState class="mt-4" title="Runs once owner sale history is connected (Phase 6)" description="A backtest needs real past sales. No backtest numbers are shown until then." />}
    </Card>

    {!pipe.has_events
      ? <EmptyState title="No outcomes recorded yet" description="Open a lead and record an outcome (contacted, conversation, appointment, listing). The funnel fills in as the team logs results." />
      : <>
          <Section title="Overall funnel" description="Parcels that reached each stage. Each stage shows the share that advanced from the stage before.">
            <Card><FunnelBars caption="Overall funnel" rows={[pipe.overall]} /></Card>
          </Section>
          <Stack gap={10}>
            <Section title="By agent"><Card><FunnelBars caption="Funnel by agent" rows={pipe.by_agent} /></Card></Section>
            <Section title="By recipe" description="Each parcel counts once, under its primary recipe."><Card><FunnelBars caption="Funnel by recipe" rows={pipe.by_recipe} /></Card></Section>
          </Stack>
        </>}
  </Stack>
</AppShell>
