---
import AppShell from '../components/ui/AppShell.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import Card from '../components/ui/Card.astro';
import Section from '../components/ui/Section.astro';
import Stack from '../components/ui/Stack.astro';
import FunnelBars from '../components/ui/FunnelBars.astro';
import SampleDataBadge from '../components/ui/SampleDataBadge.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import Button from '../components/ui/Button.astro';
import { OUTCOME_LABELS } from '../lib/data/catalog';
import { fmtDateTime } from '../lib/format';
export const prerender = false;
const pipe = await Astro.locals.data.getPipeline();
---
<AppShell title="Pipeline" active="pipeline">
  <PageHeader eyebrow="Signals to listings" title="Pipeline" description="Where flagged properties stand and the latest outcomes the team has logged.">
    <Button href="/performance" variant="secondary" icon="performance">Funnels by agent and recipe</Button>
  </PageHeader>
  <Stack gap={8}>
    {!pipe.has_events
      ? <Card><EmptyState title="No outcomes recorded yet" description="Open a lead and record an outcome (contacted, conversation, appointment, listing). The pipeline fills in as the team logs results." /></Card>
      : <>
          <Section title="Overall funnel" description="Parcels that reached each stage.">
            <Card><div class="mb-4 flex items-center gap-2">{pipe.is_sample && <SampleDataBadge />}</div><FunnelBars caption="Overall funnel" rows={[pipe.overall]} /></Card>
          </Section>
          <Section title="Recent outcomes">
            <Card padded={false}>
              {pipe.recent.length === 0
                ? <p class="px-5 py-6 text-sm text-ink-muted">No outcomes yet.</p>
                : <ul class="divide-y divide-line">
                    {pipe.recent.map((e) => (
                      <li class="flex flex-wrap items-center gap-x-4 gap-y-1 px-5 py-3" data-outcome-row>
                        <span class="rounded-full bg-accent-soft px-2.5 py-0.5 text-xs font-medium text-accent">{OUTCOME_LABELS[e.stage] ?? e.stage}</span>
                        <a href={`/leads/${e.apn}`} class="min-w-0 flex-1 truncate text-sm font-medium hover:text-accent">{e.situs_address}{e.neighborhood ? ` · ${e.neighborhood}` : ''}</a>
                        <span class="t-meta text-ink-muted">{e.by ?? 'System'} · {fmtDateTime(e.occurred_at)}</span>
                        {e.note && <p class="w-full text-sm text-ink-muted">{e.note}</p>}
                      </li>
                    ))}
                  </ul>}
            </Card>
          </Section>
        </>}
  </Stack>
</AppShell>
