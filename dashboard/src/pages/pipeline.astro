---
import AppShell from '../components/ui/AppShell.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import Card from '../components/ui/Card.astro';
import Section from '../components/ui/Section.astro';
import Stack from '../components/ui/Stack.astro';
import SampleDataBadge from '../components/ui/SampleDataBadge.astro';
import EstimateBadge from '../components/ui/EstimateBadge.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import Button from '../components/ui/Button.astro';
import { OUTCOME_LABELS } from '../lib/data/catalog';
import { fmtDateTime, fmtNum, fmtPct, fmtUsdCompact } from '../lib/format';
import { GCI_RATE, pipelineSteps } from '../lib/present';
export const prerender = false;
const pipe = await Astro.locals.data.getPipeline();
const steps = pipelineSteps(pipe.overall, pipe.stage_values);
const top = Math.max(1, steps[0]?.count ?? 0);
const sampleGci = steps.some((s) => s.sample);
// Headline: estimated GCI of parcels that reached a conversation or later (the part of the pipeline a person is actively working).
const engaged = steps.find((s) => s.key === 'conversation');
---
<AppShell title="Pipeline" active="pipeline">
  <PageHeader eyebrow="Signals to listings" title="Pipeline" description="Where flagged properties stand, from first flag to listing.">
    <Button href="/performance" variant="secondary" icon="performance">Funnels by agent and recipe</Button>
  </PageHeader>
  <Stack gap={8}>
    {!pipe.has_events
      ? <Card><EmptyState title="No outcomes recorded yet" description="Record an outcome on a lead and the pipeline fills in." /></Card>
      : <>
          <Section title="Sales progression" description="Parcels that reached each stage, and how many moved on from the stage before.">
            <Card data-pipeline-progression>
              <div class="mb-4 flex flex-wrap items-center gap-2">
                {pipe.is_sample && <SampleDataBadge />}
                {engaged?.gci != null && (
                  <p class="text-sm" data-pipeline-gci>Estimated GCI in conversation or later: <strong class="tabular-nums">{fmtUsdCompact(engaged.gci)}</strong> <span class="text-ink-muted">est.</span>{sampleGci && <> <SampleDataBadge /></>}</p>
                )}
              </div>
              <ol class="grid gap-3 md:grid-cols-5" aria-label="Pipeline stages">
                {steps.map((s, i) => (
                  <li class="min-w-0 rounded-lg border border-line bg-surface p-4" data-pipeline-stage={s.key}>
                    <p class="eyebrow">{s.label}</p>
                    <p class="mt-1 text-3xl font-semibold tabular-nums tracking-tight" data-stage-count>{fmtNum(s.count)}</p>
                    <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-sunken" aria-hidden="true"><div class="h-full rounded-full bg-accent" style={`width:${s.count > 0 ? Math.max(3, (s.count / top) * 100) : 0}%`}></div></div>
                    <p class="t-meta mt-2 text-ink-muted" data-stage-rate>{i === 0 ? 'Start of the funnel' : s.rate != null ? `${fmtPct(s.rate)} of ${steps[i - 1]!.label.toLowerCase()}` : `No ${steps[i - 1]!.label.toLowerCase()} leads yet`}</p>
                    <p class="t-meta mt-1" data-stage-gci>{s.gci != null ? <><span class="font-medium tabular-nums">{fmtUsdCompact(s.gci)}</span> <span class="text-ink-muted">est. GCI{s.sample ? ' · Sample' : ''}</span></> : <span class="text-ink-faint">No value on file</span>}</p>
                    {s.unvalued > 0 && s.gci != null && <p class="t-meta text-ink-faint">{fmtNum(s.unvalued)} without a value</p>}
                  </li>
                ))}
              </ol>
              <p class="t-meta mt-4 flex flex-wrap items-center gap-2 text-ink-muted"><EstimateBadge /> Estimated GCI is {fmtPct(GCI_RATE, 1)} of each property's estimated value, summed over the parcels that reached the stage.</p>
            </Card>
          </Section>
          <Section title="Recent outcomes">
            <Card padded={false}>
              {pipe.recent.length === 0
                ? <p class="px-5 py-6 text-sm text-ink-muted">No outcomes yet.</p>
                : <ul class="divide-y divide-line">
                    {pipe.recent.map((e) => (
                      <li class="flex flex-wrap items-center gap-x-4 gap-y-1 px-5 py-3" data-outcome-row>
                        <span class="rounded-full bg-accent-soft px-2.5 py-0.5 text-xs font-medium text-accent">{OUTCOME_LABELS[e.stage] ?? e.stage}</span>
                        <a href={`/leads/${e.apn}`} class="min-w-0 flex-1 truncate text-sm font-medium hover:text-accent">{e.situs_address}{e.neighborhood ? ` · ${e.neighborhood}` : ''}</a>
                        <span class="t-meta text-ink-muted">{e.by ?? 'System'} · {fmtDateTime(e.occurred_at)}</span>
                        {e.note && <p class="w-full text-sm text-ink-muted">{e.note}</p>}
                      </li>
                    ))}
                  </ul>}
            </Card>
          </Section>
        </>}
    {pipe.attom_usage && (
      <Section title="Owner data (ATTOM)" description="Trial calls are capped per day and every response is cached, so a parcel is never billed twice.">
        <Card data-attom-usage>
          <dl class="grid grid-cols-2 gap-6 sm:grid-cols-3">
            <div><dt class="eyebrow">Calls today</dt><dd class="mt-0.5 text-2xl font-semibold tabular-nums" data-attom-calls-today>{fmtNum(pipe.attom_usage.calls_today)}</dd><p class="t-meta text-ink-muted">of {fmtNum(pipe.attom_usage.daily_call_cap)} daily cap</p></div>
            <div><dt class="eyebrow">Calls this month</dt><dd class="mt-0.5 text-2xl font-semibold tabular-nums">{fmtNum(pipe.attom_usage.calls_this_month)}</dd><p class="t-meta text-ink-muted">trial usage</p></div>
            <div><dt class="eyebrow">Last call</dt><dd class="mt-0.5 text-sm font-medium">{pipe.attom_usage.last_call_at ? fmtDateTime(pipe.attom_usage.last_call_at) : 'No ATTOM call yet'}</dd><p class="t-meta text-ink-muted">cached responses are free</p></div>
          </dl>
        </Card>
      </Section>
    )}
  </Stack>
</AppShell>
