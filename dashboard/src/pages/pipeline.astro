---
import AppShell from '../components/ui/AppShell.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import Card from '../components/ui/Card.astro';
import Section from '../components/ui/Section.astro';
import Stack from '../components/ui/Stack.astro';
import FunnelBars from '../components/ui/FunnelBars.astro';
import SampleDataBadge from '../components/ui/SampleDataBadge.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import Button from '../components/ui/Button.astro';
import { OUTCOME_LABELS } from '../lib/data/catalog';
import AiTag from '../components/ui/AiTag.astro';
import { fmtDateTime, fmtNum } from '../lib/format';
export const prerender = false;
const pipe = await Astro.locals.data.getPipeline();
const usd = (n: number, digits: number) => '$' + n.toFixed(digits);
---
<AppShell title="Pipeline" active="pipeline">
  <PageHeader eyebrow="Signals to listings" title="Pipeline" description="Where flagged properties stand, plus the latest logged outcomes.">
    <Button href="/performance" variant="secondary" icon="performance">Funnels by agent and recipe</Button>
  </PageHeader>
  <Stack gap={8}>
    {pipe.ai && (
      <Section title="AI tasks" description="The last run of each task, and this month's spend against the budget.">
        <Card padded={false} data-ai-pipeline>
          {pipe.ai.warnings.length > 0 && (
            <ul class="border-b border-line bg-warning-soft px-5 py-3 text-sm text-warning" data-ai-warnings>{pipe.ai.warnings.map((w) => <li>{w}</li>)}</ul>
          )}
          <div class="overflow-x-auto">
            <table class="w-full min-w-[44rem] text-sm">
              <caption class="sr-only">AI tasks, last run</caption>
              <thead><tr class="border-b border-line text-left text-xs text-ink-muted">
                <th scope="col" class="px-5 py-2.5 font-medium">Task</th><th scope="col" class="px-3 py-2.5 text-right font-medium">Calls</th><th scope="col" class="px-3 py-2.5 text-right font-medium">Cached</th>
                <th scope="col" class="px-3 py-2.5 text-right font-medium">Invalid</th><th scope="col" class="px-3 py-2.5 text-right font-medium">Rejected</th><th scope="col" class="px-3 py-2.5 text-right font-medium">Tokens</th>
                <th scope="col" class="px-3 py-2.5 text-right font-medium">Cost this run</th><th scope="col" class="px-5 py-2.5 text-right font-medium">This month</th>
              </tr></thead>
              <tbody class="divide-y divide-line">
                {pipe.ai.tasks.map((t) => (
                  <tr data-ai-task={t.task}>
                    <th scope="row" class="px-5 py-3 text-left font-medium"><span class="block">{t.task.replace(/_/g, ' ')}</span><span class="t-meta block font-normal text-ink-muted">{t.status === 'skipped' ? `Skipped: ${t.skip_reason ?? ''}` : t.status === 'budget_stopped' ? 'Stopped at budget' : t.status === 'failed' ? 'Failed' : t.last_run_at ? fmtDateTime(t.last_run_at) : ''}</span></th>
                    <td class="px-3 py-3 text-right tabular-nums">{fmtNum(t.calls)}</td><td class="px-3 py-3 text-right tabular-nums">{fmtNum(t.cached)}</td>
                    <td class="px-3 py-3 text-right tabular-nums">{fmtNum(t.invalid)}</td><td class="px-3 py-3 text-right tabular-nums">{fmtNum(t.rejected)}</td><td class="px-3 py-3 text-right tabular-nums">{fmtNum(t.tokens)}</td>
                    <td class="px-3 py-3 text-right tabular-nums">{t.cost_unknown ? 'unknown' : usd(t.cost_run ?? 0, 4)}</td><td class="px-5 py-3 text-right tabular-nums">{usd(t.cost_month, 2)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="border-t border-line px-5 py-3 text-sm" data-ai-budget>Spent this month: <strong class="tabular-nums">{usd(pipe.ai.cost_month, 2)}</strong> of <strong class="tabular-nums">{usd(pipe.ai.monthly_budget_usd, 2)}</strong> budget <AiTag class="ml-1" /></p>
        </Card>
      </Section>
    )}
    {!pipe.has_events
      ? <Card><EmptyState title="No outcomes recorded yet" description="Record an outcome on a lead and the pipeline fills in." /></Card>
      : <>
          <Section title="Overall funnel" description="Parcels that reached each stage.">
            <Card><div class="mb-4 flex items-center gap-2">{pipe.is_sample && <SampleDataBadge />}</div><FunnelBars caption="Overall funnel" rows={[pipe.overall]} /></Card>
          </Section>
          <Section title="Recent outcomes">
            <Card padded={false}>
              {pipe.recent.length === 0
                ? <p class="px-5 py-6 text-sm text-ink-muted">No outcomes yet.</p>
                : <ul class="divide-y divide-line">
                    {pipe.recent.map((e) => (
                      <li class="flex flex-wrap items-center gap-x-4 gap-y-1 px-5 py-3" data-outcome-row>
                        <span class="rounded-full bg-accent-soft px-2.5 py-0.5 text-xs font-medium text-accent">{OUTCOME_LABELS[e.stage] ?? e.stage}</span>
                        <a href={`/leads/${e.apn}`} class="min-w-0 flex-1 truncate text-sm font-medium hover:text-accent">{e.situs_address}{e.neighborhood ? ` · ${e.neighborhood}` : ''}</a>
                        <span class="t-meta text-ink-muted">{e.by ?? 'System'} · {fmtDateTime(e.occurred_at)}</span>
                        {e.note && <p class="w-full text-sm text-ink-muted">{e.note}</p>}
                      </li>
                    ))}
                  </ul>}
            </Card>
          </Section>
        </>}
  </Stack>
</AppShell>
