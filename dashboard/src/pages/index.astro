---
import AppShell from '../components/ui/AppShell.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import CoverageStrip from '../components/ui/CoverageStrip.astro';
import Section from '../components/ui/Section.astro';
import Grid from '../components/ui/Grid.astro';
import Stack from '../components/ui/Stack.astro';
import Card from '../components/ui/Card.astro';
import LeadCard from '../components/ui/LeadCard.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import Button from '../components/ui/Button.astro';
import SignalFeedItem from '../components/ui/SignalFeedItem.astro';
import ApprovalRow from '../components/ui/ApprovalRow.astro';
import CallTaskRow from '../components/ui/CallTaskRow.astro';
import { fmtDate } from '../lib/format';

export const prerender = false;
const feed = await Astro.locals.data.getTodayFeed();
---
<AppShell title="Today" active="today">
  <PageHeader eyebrow={fmtDate(feed.as_of.slice(0, 10))} title="Good morning" description="Your top ten leads and what changed overnight.">
    <Button href="/map" variant="secondary" icon="map" class="max-sm:hidden">Open map</Button>
  </PageHeader>

  <Stack gap={10}>
    <CoverageStrip coverage={feed.coverage} />

    <Grid split="main-aside" gap={8}>
      <Section title="Top 10 leads" description="Ranked by score. Scores are computed from stored records, never by AI.">
        <Stack as="ul" gap={3}>
          {feed.top_leads.map((l, i) => <li><LeadCard lead={l} rank={i + 1} /></li>)}
        </Stack>
        <p class="mt-4 text-sm"><a href="/leads" class="font-medium text-accent hover:underline">See all leads →</a></p>
      </Section>

      <Stack gap={8}>
        <Section title="New since yesterday">
          <Card padded={false}>
            {feed.new_signals.length === 0
              ? <EmptyState title="Nothing new" description="No new signals were detected overnight." />
              : <ul class="divide-y divide-line">{feed.new_signals.map((s) => <SignalFeedItem signal={s} />)}</ul>}
            {feed.new_signals_total > feed.new_signals.length && <p class="border-t border-line px-5 py-3 text-xs text-ink-muted">+ {feed.new_signals_total - feed.new_signals.length} more new signals</p>}
          </Card>
        </Section>

        <Section title={`Approvals waiting · ${feed.approvals_total}`} description="Drafts need a human approval before anything is sent.">
          <Card padded={false}>
            {feed.approvals.length === 0
              ? <EmptyState title="All clear" description="No drafts are waiting for approval." />
              : <ul class="divide-y divide-line">{feed.approvals.map((o) => <ApprovalRow item={o} />)}</ul>}
            {feed.approvals_total > feed.approvals.length && <p class="border-t border-line px-5 py-3 text-xs text-ink-muted">+ {feed.approvals_total - feed.approvals.length} more waiting</p>}
          </Card>
        </Section>

        <Section title="Call tasks due">
          <Card padded={false}>
            {feed.call_tasks.length === 0
              ? <EmptyState title="No calls due" />
              : <ul class="divide-y divide-line">{feed.call_tasks.map((o) => <CallTaskRow task={o} />)}</ul>}
            <p class="border-t border-line px-5 py-3 text-xs text-ink-muted">Calls are placed manually by the team. Nothing is dialed automatically.</p>
          </Card>
        </Section>
      </Stack>
    </Grid>
  </Stack>
</AppShell>
