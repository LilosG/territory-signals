---
import AppShell from '../components/ui/AppShell.astro';
import LeadMap from '../components/map/LeadMap.astro';
export const prerender = false;
const config = await Astro.locals.data.getConfig();
// Marks the page as sample when any score on the map is sample data (the points themselves load from /api/map).
await Astro.locals.data.getMapData({ minScore: 101 }).catch(() => null);
---
<AppShell title="Map" active="map" bleed>
  <h1 class="sr-only">Map of scored parcels</h1>
  <LeadMap recipes={config.recipes.filter((r) => r.enabled)} neighborhoods={config.territory.neighborhoods} territory={Astro.locals.territory} />
</AppShell>
