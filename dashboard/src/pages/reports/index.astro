---
import AppShell from '../../components/ui/AppShell.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import Card from '../../components/ui/Card.astro';
import Grid from '../../components/ui/Grid.astro';
import Stack from '../../components/ui/Stack.astro';
import Section from '../../components/ui/Section.astro';
import Button from '../../components/ui/Button.astro';
import SampleDataBadge from '../../components/ui/SampleDataBadge.astro';
import { slugify } from '../../lib/format';
export const prerender = false;
const config = await Astro.locals.data.getConfig();
const all = await Astro.locals.data.getTrends('All');
const areas = await Promise.all(config.territory.neighborhoods.map((a) => Astro.locals.data.getTrends(a)));
---
<AppShell title="Reports" active="reports">
  <PageHeader eyebrow="Built from the trend data" title="Reports" description="Print-ready newsletter and neighborhood pages · sample-based sections are marked" />
  <Stack gap={8}>
    <Section title="Newsletter">
      <Card class="flex flex-wrap items-center justify-between gap-4">
        <div class="min-w-0">
          <div class="flex flex-wrap items-center gap-2"><h3 class="t-h2">Market update for the whole territory</h3>{all.is_sample && <SampleDataBadge />}</div>
          <p class="mt-1 text-sm text-ink-muted">One-page summary with headline charts per neighborhood.</p>
        </div>
        <Button href="/trends/newsletter" variant="primary" icon="print" id="open-newsletter">Open newsletter</Button>
      </Card>
    </Section>
    <Section title="Neighborhood market reports" description="One printable report per neighborhood.">
      <Grid cols={3} gap={4}>
        {areas.map((t) => (
          <Card as="article" class="flex flex-col gap-3" data-report={slugify(t.area)}>
            <div class="flex flex-wrap items-center gap-2"><h3 class="t-h2">{t.area}</h3>{t.is_sample && <SampleDataBadge />}</div>
            <p class="text-sm text-ink-muted">Sales activity, permits, short-term rentals, upzoning estimates and recipe matches.</p>
            <div class="mt-auto"><Button href={`/reports/${slugify(t.area)}`} variant="secondary" size="sm" icon="reports">Open report</Button></div>
          </Card>
        ))}
      </Grid>
    </Section>
  </Stack>
</AppShell>
