---
import AppShell from '../components/ui/AppShell.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import Section from '../components/ui/Section.astro';
import Stack from '../components/ui/Stack.astro';
import Grid from '../components/ui/Grid.astro';
import Cluster from '../components/ui/Cluster.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import Select from '../components/ui/Select.astro';
import FilterBar from '../components/ui/FilterBar.astro';
import TabPanel from '../components/ui/TabPanel.astro';
import Tabs from '../components/ui/Tabs.astro';
import Drawer from '../components/ui/Drawer.astro';
import DataTable from '../components/ui/DataTable.astro';
import StatTile from '../components/ui/StatTile.astro';
import ScoreRing from '../components/ui/ScoreRing.astro';
import ScoreBreakdown from '../components/ui/ScoreBreakdown.astro';
import SignalChip from '../components/ui/SignalChip.astro';
import RecipeTag from '../components/ui/RecipeTag.astro';
import LeadCard from '../components/ui/LeadCard.astro';
import SignalTimeline from '../components/ui/SignalTimeline.astro';
import SourceLink from '../components/ui/SourceLink.astro';
import SampleDataBadge from '../components/ui/SampleDataBadge.astro';
import EstimateBadge from '../components/ui/EstimateBadge.astro';
import ConfidenceIndicator from '../components/ui/ConfidenceIndicator.astro';
import CoverageStrip from '../components/ui/CoverageStrip.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import FactList from '../components/ui/FactList.astro';
import StatusPill from '../components/ui/StatusPill.astro';
import FunnelBars from '../components/ui/FunnelBars.astro';
import TrendCard from '../components/ui/TrendCard.astro';
import Icon from '../components/ui/Icon.astro';
import { fixturesProvider } from '../lib/data/fixtures';
import { brand } from '../config/brand';

// The gallery always renders from the fixture bundle so it works without a database or a session.
const data = fixturesProvider(() => { Astro.locals.sample.used = true; });
const [feed, pipe, lead, trends] = await Promise.all([data.getTodayFeed(), data.getPipeline(), data.getLead((await data.getLeads()).items[0]!.parcel.apn), data.getTrends('All')]);
const l = lead!;
const swatch = (name: string, cls: string, text = 'text-ink') => ({ name, cls, text });
const neutrals = [swatch('canvas', 'bg-canvas'), swatch('surface', 'bg-surface'), swatch('sunken', 'bg-sunken'), swatch('line', 'bg-line'), swatch('line-strong', 'bg-line-strong'), swatch('ink-faint', 'bg-ink-faint', 'text-accent-fg'), swatch('ink-muted', 'bg-ink-muted', 'text-accent-fg'), swatch('ink', 'bg-ink', 'text-accent-fg')];
const accents = [swatch('accent', 'bg-accent', 'text-accent-fg'), swatch('accent-strong', 'bg-accent-strong', 'text-accent-fg'), swatch('accent-soft', 'bg-accent-soft')];
const semantic = [swatch('good', 'bg-good', 'text-accent-fg'), swatch('good-soft', 'bg-good-soft'), swatch('warning', 'bg-warning', 'text-accent-fg'), swatch('warning-soft', 'bg-warning-soft'), swatch('critical', 'bg-critical', 'text-accent-fg'), swatch('critical-soft', 'bg-critical-soft')];
const bands = [swatch('band-low', 'bg-band-low'), swatch('band-watch', 'bg-band-watch'), swatch('band-warm', 'bg-band-warm', 'text-accent-fg'), swatch('band-hot', 'bg-band-hot', 'text-accent-fg')];
const types = [['text-4xl', '4xl · 48'], ['text-3xl', '3xl · 36'], ['text-2xl', '2xl · 28'], ['text-xl', 'xl · 22'], ['text-lg', 'lg · 18'], ['text-base', 'base · 15'], ['text-sm', 'sm · 13'], ['text-xs', 'xs · 12'], ['text-2xs', '2xs · 11']] as const;
---
<AppShell title="Design system" active="system">
  <PageHeader eyebrow="Component gallery" title="Design system" description={`Every token and component the screens are built from. Accent and brand values come from src/config/brand.ts (${brand.name}).`} />
  <Stack gap={12}>
    <Section title="Color tokens" description="Warm neutrals, one navy accent, three semantic colors, and a navy score ramp.">
      <Card>
        <Stack gap={6}>
          {[['Neutrals', neutrals], ['Accent', accents], ['Semantic', semantic], ['Score bands', bands]].map(([label, items]) => (
            <div>
              <p class="eyebrow mb-2">{label}</p>
              <div class="grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-8">
                {(items as typeof neutrals).map((s) => <div class="overflow-hidden rounded-md border border-line"><div class:list={['h-14', s.cls]}></div><p class="px-2 py-1.5 text-2xs font-medium">{s.name}</p></div>)}
              </div>
            </div>
          ))}
        </Stack>
      </Card>
    </Section>

    <Section title="Type, spacing, radius, elevation">
      <Grid split="even" gap={6}>
        <Card><p class="eyebrow mb-3">Type scale · Inter, tabular figures</p>
          <Stack gap={2}>{types.map(([cls, label]) => <p class:list={[cls, 'font-semibold']}>{label} <span class="font-normal text-ink-muted">1,234,567.89</span></p>)}</Stack></Card>
        <Card><Stack gap={6}>
          <div><p class="eyebrow mb-3">Spacing (4 / 8 base)</p><div class="flex items-end gap-3">{[1, 2, 3, 4, 6, 8, 12].map((n) => <div class="flex flex-col items-center gap-1"><div class="bg-accent" style={`width:${n * 4}px;height:${n * 4}px`}></div><span class="text-2xs text-ink-muted">{n * 4}</span></div>)}</div></div>
          <div><p class="eyebrow mb-3">Radius</p><Cluster gap={4}>{['rounded-sm', 'rounded-md', 'rounded-lg', 'rounded-full'].map((r) => <div class:list={['h-12 w-12 border border-line-strong bg-sunken', r]}></div>)}</Cluster></div>
          <div><p class="eyebrow mb-3">Elevation</p><Cluster gap={4}>{['shadow-xs', 'shadow-sm', 'shadow-md', 'shadow-lg'].map((s) => <div class:list={['grid h-14 w-20 place-items-center rounded-md bg-surface text-2xs text-ink-muted', s]}>{s.replace('shadow-', '')}</div>)}</Cluster></div>
        </Stack></Card>
      </Grid>
    </Section>

    <Section title="Buttons, select, filter bar">
      <Card><Stack gap={6}>
        <Cluster gap={3}><Button variant="primary">Primary</Button><Button>Secondary</Button><Button variant="ghost">Ghost</Button><Button variant="primary" icon="print">With icon</Button><Button size="sm">Small</Button><Button disabled icon="lock" title="Available in Phase 5">Disabled</Button></Cluster>
        <FilterBar label="Example filters"><Select label="Neighborhood" name="n" options={[{ value: '', label: 'All neighborhoods' }, { value: 'lj', label: 'La Jolla' }]} /><Select label="Recipe" name="r" options={[{ value: '', label: 'All recipes' }]} /><Select label="Score range" name="s" options={[{ value: '', label: 'All scores' }]} /></FilterBar>
        <Cluster gap={3}><Button data-drawer-open="demo-drawer" variant="secondary">Open drawer</Button><span class="text-sm text-ink-muted">Drawer: focus-trapped, closes with Esc.</span></Cluster>
      </Stack></Card>
    </Section>

    <Section title="Badges and indicators">
      <Card><Stack gap={6}>
        <Cluster gap={3}><ScoreRing score={92} size="md" showLabel /><ScoreRing score={71} size="md" showLabel /><ScoreRing score={48} size="md" showLabel /><ScoreRing score={22} size="md" showLabel /><ScoreRing score={92} size="lg" /><ScoreRing score={55} size="sm" /></Cluster>
        <Cluster gap={2}><SignalChip type="permit_approved" details={{ approval_type: "Approval - Construction - Demolition Pmt" }} /><SignalChip type="sb9_lot_split_estimate" estimate /><SignalChip type="stro_license_removed" /><SignalChip type="ownership_transfer" /><RecipeTag name="Tired landlord" /><SampleDataBadge /><EstimateBadge /></Cluster>
        <Cluster gap={6}><ConfidenceIndicator confidence={0.98} method="apn" /><ConfidenceIndicator confidence={0.83} method="address" /><ConfidenceIndicator confidence={0.62} method="name" /></Cluster>
        <Cluster gap={2}><StatusPill tone="good">Live</StatusPill><StatusPill tone="warning">Running</StatusPill><StatusPill tone="critical">Failed</StatusPill><StatusPill>Not connected</StatusPill></Cluster>
        <SourceLink sourceKey={l.signals[0]!.source_key} recordId={l.signals[0]!.source_record_id} />
      </Stack></Card>
    </Section>

    <Section title="Stat tiles and coverage strip"><Stack gap={4}>
      <CoverageStrip coverage={feed.coverage} />
      <Card><dl class="grid grid-cols-2 gap-6 sm:grid-cols-4"><StatTile label="Standard" value="1,284" /><StatTile label="With hint" value="38%" hint="of past sales" /><StatTile label="Sample" value="$2.4M" sample /><StatTile label="Emphasis" value="74" emphasis hint="days early" /></dl></Card>
    </Stack></Section>

    <Section title="Lead card"><Grid cols={2} gap={4}><LeadCard lead={feed.top_leads[0]!} rank={1} /><LeadCard lead={feed.top_leads[5]!} rank={6} /></Grid></Section>

    <Section title="Signal timeline, score breakdown, fact list"><Grid cols={3} gap={4}>
      <Card><SignalTimeline signals={l.signals.slice(0, 4)} /></Card>
      <Card><ScoreBreakdown items={l.score_items} /></Card>
      <Card><FactList items={[{ label: 'Owner', value: l.owner!.owner_name!, sample: true }, { label: 'Estimated equity', value: '$1.9M', estimate: true, sample: true }, { label: 'Mortgage', value: 'No open mortgage' }]} /></Card>
    </Grid></Section>

    <Section title="Data table (sortable)">
      <DataTable caption="Example leads" defaultSort={{ key: 'score', dir: 'desc' }}
        columns={[{ key: 'addr', label: 'Address', sortable: true }, { key: 'hood', label: 'Neighborhood', sortable: true, hideOnMobile: true }, { key: 'score', label: 'Score', type: 'score', sortable: true, align: 'right' }, { key: 'sig', label: 'Signals', type: 'number', sortable: true, align: 'right' }]}
        rows={feed.top_leads.slice(0, 5).map((x) => ({ href: `/leads/${x.parcel.apn}`, cells: { addr: { v: x.parcel.situs_address }, hood: { v: x.parcel.neighborhood }, score: { v: x.score.score }, sig: { v: x.top_components.length } } }))} />
    </Section>

    <Section title="Tabs, funnel, trend card, empty state"><Stack gap={6}>
      <Card><Tabs label="Example tabs" tabs={[{ id: 'a', label: 'Letter' }, { id: 'b', label: 'Email' }, { id: 'c', label: 'Call script' }]}>
        <TabPanel id="a" active><p class="text-sm">Letter panel. Arrow keys move between tabs.</p></TabPanel>
        <TabPanel id="b"><p class="text-sm">Email panel.</p></TabPanel>
        <TabPanel id="c"><p class="text-sm">Call script panel.</p></TabPanel>
      </Tabs></Card>
      <Card><FunnelBars caption="Example funnel" rows={pipe.by_agent.slice(0, 2)} /></Card>
      <Grid cols={2} gap={4}><TrendCard metric={trends.metrics[0]!} months={trends.months} idPrefix="sys" compact /><EmptyState title="Nothing here yet" description="Empty states explain what will appear and why."><Button size="sm">Optional action</Button></EmptyState></Grid>
    </Stack></Section>

    <Section title="Icons"><Card><Cluster gap={4}>{(['today', 'map', 'trends', 'pipeline', 'settings', 'external', 'print', 'close', 'arrow', 'lock', 'info', 'check', 'mail', 'phone', 'share', 'sort'] as const).map((n) => <span class="flex flex-col items-center gap-1 text-ink-muted"><Icon name={n} size={22} /><span class="text-2xs">{n}</span></span>)}</Cluster></Card></Section>
  </Stack>
  <Drawer id="demo-drawer" title="Drawer example"><p class="text-sm text-ink-muted">Side panel on desktop, bottom sheet on phones. Used for lead previews on the map.</p></Drawer>
</AppShell>
