---
import PrintShell from '../../components/ui/PrintShell.astro';
import Stack from '../../components/ui/Stack.astro';
import Section from '../../components/ui/Section.astro';
import TrendCard from '../../components/ui/TrendCard.astro';
import { data } from '../../lib/data';
import { brand } from '../../config/brand';
const config = await data.getConfig();
const all = await data.getTrends('All');
const byArea = await Promise.all(config.territory.neighborhoods.map((a) => data.getTrends(a)));
const pick = (t: typeof all, k: string) => t.metrics.find((m) => m.key === k)!;
---
<PrintShell title="Neighborhood update" backHref="/trends" backLabel="Back to trends">
  <Stack gap={10}>
    <header>
      <p class="eyebrow">{brand.name} · Market update</p>
      <h1 class="mt-2 text-3xl font-semibold">The {config.territory.neighborhoods.join(', ').replace(/, ([^,]*)$/, ' and $1')} market, in brief</h1>
      <p class="mt-2 text-base text-ink-muted">Twelve months to November 2026.</p>
    </header>
    <Section title="Across the territory">
      <TrendCard metric={pick(all, 'turnover')} months={all.months} idPrefix="nl-all" compact />
      <TrendCard metric={pick(all, 'permits')} months={all.months} idPrefix="nl-all" compact />
    </Section>
    {byArea.map((t) => (
      <Section title={t.area}>
        <ul class="flex flex-col gap-3">
          {t.metrics.map((m) => <li class="border-l-2 border-accent pl-4"><p class="text-sm font-medium">{m.title}</p><p class="text-sm text-ink-muted">{m.takeaway}</p></li>)}
        </ul>
      </Section>
    ))}
  </Stack>
</PrintShell>
