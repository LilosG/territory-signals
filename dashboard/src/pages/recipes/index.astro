---
import AppShell from '../../components/ui/AppShell.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import Card from '../../components/ui/Card.astro';
import Grid from '../../components/ui/Grid.astro';
import Stack from '../../components/ui/Stack.astro';
import ScoreRing from '../../components/ui/ScoreRing.astro';
import SampleDataBadge from '../../components/ui/SampleDataBadge.astro';
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';
import Fact from '../../components/ui/Fact.astro';
import { enabledRecipeCount, loadClientConfig } from '../../lib/config';
import { fmtNum } from '../../lib/format';
export const prerender = false;
// Every recipe the client has switched on gets a card when it has matches. Distress recipes are labeled, not hidden.
const all = await Astro.locals.data.getRecipes();
const approval = new Set(loadClientConfig().outreach.approval_required_recipes);
const active = all.filter((r) => r.enabled && r.parcels > 0).sort((a, b) => b.strong - a.strong || b.parcels - a.parcels);
const waiting = all.filter((r) => r.parcels === 0);
const where = Astro.locals.territory ?? 'the whole territory';
---
<AppShell title="Recipes" active="recipes">
  <PageHeader eyebrow={`${enabledRecipeCount()} switched on`} title="Recipes" description={`Plain rules for likely sellers · counts for ${where}`} />
  <Stack gap={8}>
    <Grid cols={2} gap={6}>
      {active.map((r) => (
        <Card as="article" class="flex flex-col gap-4" data-recipe={r.key}>
          <header>
            <div class="flex flex-wrap items-center gap-2"><h2 class="t-h2">{r.name}</h2>{r.is_sample && <SampleDataBadge />}{approval.has(r.key) && <span data-approval-chip class="inline-flex items-center whitespace-nowrap rounded-full bg-sunken px-2 py-0.5 text-xs font-medium text-ink-muted">Approval required</span>}</div>
            <p class="mt-1 text-sm text-ink-muted">{r.description}</p>
          </header>
          <dl class="grid grid-cols-3 gap-3 border-y border-line py-3">
            <div><dt class="eyebrow">Parcels</dt><dd class="mt-0.5 text-xl font-semibold tabular-nums">{fmtNum(r.parcels)}</dd></div>
            <div><dt class="eyebrow">New this week</dt><dd class="mt-0.5 text-xl font-semibold tabular-nums">{r.new_this_week > 0 ? <span class="text-gold-strong">+{fmtNum(r.new_this_week)}</span> : '0'}</dd></div>
            <div><dt class="eyebrow">Strong (60+)</dt><dd class="mt-0.5 text-xl font-semibold tabular-nums">{fmtNum(r.strong)}</dd></div>
          </dl>
          <div>
            <p class="eyebrow mb-2">Top leads</p>
            <ul class="flex flex-col gap-2">
              {r.top.slice(0, 5).map((t) => (
                <li><a href={`/leads/${t.apn}`} class="flex items-center gap-3 rounded-md py-1 hover:text-accent">
                  <ScoreRing score={t.score} size="xs" />
                  <span class="min-w-0 flex-1"><span class="block truncate text-sm font-medium">{t.situs_address}</span>{t.top_signal && <span class="block truncate text-xs text-ink-muted" data-top-signal><Fact {...t.top_signal} /></span>}</span>
                  <span class="t-meta shrink-0 text-ink-muted max-sm:hidden">{t.neighborhood}</span>
                </a></li>
              ))}
            </ul>
          </div>
          <div class="mt-auto"><Button size="sm" variant="secondary" href={`/leads?recipe=${r.key}`}>View all {fmtNum(r.parcels)} in Leads</Button></div>
        </Card>
      ))}
    </Grid>
    {waiting.length > 0 && (
      <section aria-labelledby="wait-h" data-waiting class="rounded-lg border border-line bg-surface px-4 py-3 sm:px-5">
        <h2 id="wait-h" class="eyebrow">Waiting on data</h2>
        <ul class="mt-2 flex flex-col divide-y divide-line">
          {waiting.map((r) => (
            <li data-waiting-recipe={r.key} class="flex items-center gap-3 py-2 text-sm">
              <span class="text-ink-muted"><Icon name="recipes" size={16} /></span>
              <span class="font-medium text-ink">{r.name}</span>
              <span class="min-w-0 flex-1 truncate text-ink-muted">{r.idle_reason}</span>
            </li>
          ))}
        </ul>
      </section>
    )}
  </Stack>
</AppShell>
