---
import AppShell from '../components/ui/AppShell.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import Card from '../components/ui/Card.astro';
import Section from '../components/ui/Section.astro';
import Stack from '../components/ui/Stack.astro';
import Grid from '../components/ui/Grid.astro';
import FactList from '../components/ui/FactList.astro';
import DataTable from '../components/ui/DataTable.astro';
import { fmtNum } from '../lib/format';
export const prerender = false;
const config = await Astro.locals.data.getConfig();
if (config.owner_data_provider === 'sample') Astro.locals.sample.used = true;
const tp = config.team_profile;
---
<AppShell title="Settings" active="settings">
  <PageHeader eyebrow="Read-only" title="Settings" description="How this workspace is set up · changes go through your administrator" />
  <Stack gap={10}>
    <Grid split="even" gap={6}>
      <Card as="section" aria-labelledby="client-h">
        <h2 id="client-h" class="mb-4 text-base font-semibold">Client</h2>
        <FactList items={[
          { label: 'Client', value: config.display_name }, { label: 'Planning areas', value: config.territory.planning_areas.join(', ') }, { label: 'ZIP codes', value: config.territory.zips.join(', ') },
          { label: 'Owner data provider', value: config.owner_data_provider, sample: config.owner_data_provider === 'sample' },
          { label: 'Brokerage', value: tp.brokerage || 'Not set' }, { label: 'Office address', value: tp.office_address || 'Not set' },
        ]} />
      </Card>
      <Card as="section" aria-labelledby="send-h">
        <h2 id="send-h" class="mb-4 text-base font-semibold">Outreach</h2>
        <FactList items={[
          { label: 'Mode', value: config.outreach.mode === 'preview' ? 'Preview (nothing is sent)' : config.outreach.mode },
          { label: 'Weekly send cap per agent', value: fmtNum(config.outreach.weekly_send_cap_per_agent) },
          { label: 'Drafts per run', value: fmtNum(config.outreach.drafts_per_run) },
          { label: 'Cooldown', value: `${config.outreach.cooldown_days} days` },
          { label: 'Automated texts or calls', value: 'Never' },
        ]} />
        <p class="mt-4 text-xs text-ink-muted">Preview mode: nothing is sent.</p>
      </Card>
    </Grid>

    <Section title="Recipes">
      <DataTable caption="Recipes" columns={[{ key: 'n', label: 'Recipe' }, { key: 'd', label: 'Rule', hideOnMobile: true }, { key: 's', label: 'Status', align: 'right' }]}
        rows={config.recipes.map((r) => ({ cells: { n: { v: r.name }, d: { v: r.description }, s: { v: r.enabled ? 'On' : 'Off' } } }))} />
    </Section>

    <Section title="More">
      <ul class="flex flex-wrap gap-3 text-sm">
        <li><a href="/data-sources" class="font-medium text-accent hover:underline">Data sources →</a></li>
        <li><a href="/team" class="font-medium text-accent hover:underline">Team →</a></li>
      </ul>
    </Section>
  </Stack>
</AppShell>
